# ══════════════════════════════════════════════════════════════════════
#  Curblit environment variables
#  Fill in the REQUIRED section to run locally. Everything under OPTIONAL
#  can stay blank — the related feature is simply skipped.
#  Copy to .env.local and fill in. Never commit real keys.
# ══════════════════════════════════════════════════════════════════════


# ──────────────────────────── REQUIRED ────────────────────────────

# ── App URLs ──
# Local: keep as-is. Production: your app domain, e.g. https://curblit.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Where customer sites are served: <slug>.<this>. Local: keep as-is (open http://my-site.localhost:3000).
# Production: a SEPARATE domain from the app, e.g. curblit.site (wildcard *.curblit.site → this app).
# Just the domain, e.g. curblit.site (a leading "*." or "https://" is tolerated). DNS needs a wildcard *.curblit.site record.
NEXT_PUBLIC_SITES_DOMAIN=localhost:3000

# ── Supabase ──  (supabase.com → your project → Project Settings → API Keys)
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable" key (sb_publishable_…). Older projects: the "anon" key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret" key (sb_secret_…). Older projects: the "service_role" key. Server-only — keep private.
SUPABASE_SECRET_KEY=

# ── OpenRouter ──  (openrouter.ai → Keys)
OPENROUTER_API_KEY=

# ── Stripe ──  (Stripe dashboard → Developers → API keys; use a test key sk_test_… locally)
STRIPE_SECRET_KEY=
# Locally: printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook` (whsec_…).
# Production: printed by `npm run stripe:setup`, or Developers → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=


# ──────────────────────────── RECOMMENDED ────────────────────────────

# Comma-separated emails that get /admin and the daily business digest.
ADMIN_EMAILS=
# Shown on legal pages and in the footer.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Email (resend.com → API Keys). Powers form-submission emails, welcome email, admin alerts.
RESEND_API_KEY=
# Must be on a domain you've verified in Resend.
EMAIL_FROM="Curblit <hello@curblit.com>"
# Your business mailing address, shown in onboarding/marketing emails (required by CAN-SPAM in the US).
EMAIL_POSTAL_ADDRESS=


# ──────────────────────────── OPTIONAL ────────────────────────────

# Vercel Web Analytics is built in (enable it in the Vercel project → Analytics tab).
# Optional, only for running ads (these set cookies): GA4 measurement ID, e.g. G-XXXXXXX.
NEXT_PUBLIC_GA_ID=
# Meta (Facebook/Instagram) Pixel for running ads to curblit.com, e.g. 123456789012345.
NEXT_PUBLIC_META_PIXEL_ID=

# Which sign-in buttons to show. Enable the same providers in Supabase → Authentication → Providers.
# Leave empty for email-only sign-in.
NEXT_PUBLIC_AUTH_PROVIDERS=google,github

# Max AI spend per UTC day (USD). Free users pause at 80% of it; you get an email.
DAILY_AI_BUDGET_USD=75

# Stripe mock/simulator: point the SDK somewhere other than api.stripe.com, e.g. http://localhost:12111
STRIPE_API_BASE=
# Collect sales tax/VAT with Stripe Tax at checkout (set up Stripe Tax first): true / blank
STRIPE_AUTOMATIC_TAX=

# Custom domains for customers, attached to Vercel automatically (vercel.com → Account Settings → Tokens;
# project ID under Project → Settings → General; team ID only if the project is in a team).
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# DNS targets shown to customers when connecting a domain (defaults are Vercel's).
CUSTOM_DOMAIN_A_RECORD=
CUSTOM_DOMAIN_CNAME=

# Protects /api/cron/daily. Vercel Cron sends it automatically once set in Vercel's env vars.
CRON_SECRET=

# Legal pages (have a lawyer review /legal/* before launch).
# Legal owner shown in Terms/Privacy. Defaults to "Anchorforge Digital"; for a sole proprietorship use e.g. "Jane Doe d/b/a Anchorforge Digital".
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_GOVERNING_LAW=

# Model overrides — comma-separated, first = primary, rest = fallbacks. Blank = defaults in src/config/models.ts.
MODELS_FAST=
MODELS_STANDARD=
MODELS_MAX=
MODELS_UTILITY=
MODELS_IMAGE=

# Official social profiles, comma-separated (footer links + schema.org sameAs), e.g.
# https://www.instagram.com/curblit,https://www.youtube.com/@curblit
NEXT_PUBLIC_SOCIAL_LINKS=https://www.instagram.com/curblit/
# Your X/Twitter handle once you own it, e.g. @curblit
NEXT_PUBLIC_TWITTER_HANDLE=
